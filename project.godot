; Engine configuration file.
; AXIVA: iPhone vertical slice. Web export is a device-validation route.
config_version=5

[application]
config/name="AXIVA"
run/main_scene="res://main.tscn"
config/icon="res://assets/app/machi-loop-icon-final.svg"

[display]
window/size/viewport_width=430
window/size/viewport_height=932
window/size/window_width_override=430
window/size/window_height_override=932
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true

audio/driver/enable_input=false
